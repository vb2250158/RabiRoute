{
  "schemaVersion": 1,
  "components": [
    {
      "id": "core",
      "title": "核心运行时",
      "description": "Node 运行时、Host、后端、插件与文档。安装必需。",
      "required": true,
      "default": true,
      "manifestPrefixes": []
    },
    {
      "id": "desktop",
      "title": "桌面组件（托盘、桌宠、字幕窗口）",
      "description": "Qt 桌面运行时。Host 启动后要等待托盘就绪，因此该组件必需。",
      "required": true,
      "default": true,
      "manifestPrefixes": [
        "desktop-runtime/"
      ]
    },
    {
      "id": "agent-codex",
      "title": "Codex Agent（OpenAI Codex CLI）",
      "description": "内置 Codex CLI 原生二进制。不装则 Codex 适配器无法创建新任务，其他功能不受影响。",
      "required": false,
      "default": true,
      "manifestPrefixes": [
        "node_modules/@openai/"
      ]
    },
    {
      "id": "agent-cli",
      "title": "独立 Agent CLI",
      "description": "独立 Agent 与 CLI 入口、运行配置、集成钩子和独立托盘资源。Host 共用库随核心安装。",
      "required": false,
      "default": false,
      "manifestPrefixes": [
        "apps/rabi-agent/rabi-agent.mjs",
        "apps/rabi-agent/rabi-cli.mjs",
        "apps/rabi-agent/recover-release.mjs",
        "apps/rabi-agent/runtime/",
        "apps/rabi-agent/dist/agent-hooks/",
        "apps/rabi-agent/desktop/start-windows.ps1",
        "apps/rabi-agent/desktop/tray.ps1",
        "apps/rabi-agent/desktop/rabi-agent.ico",
        "apps/rabi-agent/test/"
      ]
    }
  ]
}
