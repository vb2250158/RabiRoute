<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RabiRouteHost</AssemblyName>
    <RootNamespace>RabiRoute.WindowsBootstrap</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/desktop/windows-bootstrap</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="RabiRouteBootstrap.Tests\**\*.cs" />
  </ItemGroup>
</Project>
