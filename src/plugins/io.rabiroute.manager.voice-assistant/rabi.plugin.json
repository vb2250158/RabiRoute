    "manager.speech@1",
    "manager.persona@1",
    "host.agent-adapters@1",
    "host.manager.operations@1",
    "host.manager.voice-assistant@2"
  ],
  "optional": [
    "manager.desktop-pet@1"
  ],
  "permissions": []
}
