{
  "schemaVersion": 2,
  "id": "io.rabiroute.manager.voice-assistant",
  "version": "1.1.27",
  "displayName": "语音助手",
  "description": "Rabi PC 内置模型、人格与工具的实时语音助手",
  "icon": "mdi-microphone-message",
  "entries": {
    "manager": {
      "execution": "in_process",
      "module": "./manager.mjs"
    },
    "web": {
      "execution": "in_process",
      "module": "./web/client.mjs"
    }
  },
  "provides": [
    "manager.voice-assistant@1",
    "agent.adapter.voice-assistant@1"
  ],
  "requires": [
