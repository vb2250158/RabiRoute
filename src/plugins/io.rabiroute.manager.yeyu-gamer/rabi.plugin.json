{
  "schemaVersion": 2,
  "id": "io.rabiroute.manager.yeyu-gamer",
  "version": "0.1.3",
  "displayName": "YeYu Gamer 连接",
  "description": "查看本机游戏助手状态并提交游戏计划",
  "icon": "mdi-gamepad-variant",
  "entries": {
    "manager": {
      "execution": "in_process",
      "module": "./manager.mjs"
    }
  },
  "provides": [
    "manager.yeyu-gamer@1"
  ],
  "requires": [
    "host.manager.yeyu-gamer@2",
    "manager.core@1"
  ],
  "optional": [],
  "permissions": [],
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/vb2250158/RabiRoute/examples/schemas/yeyu-gamer-manager-config.schema.json",
    "title": "RabiRoute YeYu Gamer Manager integration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "",
        "description": "Explicit loopback YeYu Gamer Manager API v1 URL; empty means not configured."
      },
      "runtimeDir": {
        "type": "string",
        "minLength": 1,
        "description": "Optional absolute local YeYu Gamer runtime directory. Network paths are rejected."
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 30000,
        "default": 3000
      }
    }
  }
}
