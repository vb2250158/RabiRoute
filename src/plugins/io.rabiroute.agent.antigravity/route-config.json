  },
  "environmentFields": {
    "ANTIGRAVITY_CONVERSATION_ID": "antigravityConversationId",
    "ANTIGRAVITY_CONVERSATION_NAME": "antigravityConversationName",
    "ANTIGRAVITY_CWD": "antigravityCwd"
