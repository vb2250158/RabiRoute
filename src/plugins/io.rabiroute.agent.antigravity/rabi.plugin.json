{
  "schemaVersion": 2,
  "id": "io.rabiroute.agent.antigravity",
  "version": "0.1.2",
  "displayName": "Antigravity（Google 的 Agent 开发环境）",
  "description": "将消息交给 Antigravity，通过其原有任务入口处理。",
  "icon": "mdi-robot-outline",
  "entries": {
    "manager": {
      "execution": "in_process",
      "module": "./manager.mjs"
    },
    "gateway": {
      "execution": "in_process",
      "module": "./gateway.mjs"
    },
    "web": {
      "execution": "in_process",
      "module": "./web/client.mjs"
    }
  },
  "provides": [
    "agent.adapter.antigravity@1"
  ],
  "requires": [
    "host.agent-adapters@1"
  ],
  "optional": [],
  "permissions": []
}
