{
  "schemaVersion": 2,
  "id": "io.rabiroute.manager.diagnostics",
  "version": "0.1.11",
  "displayName": "日志诊断",
  "description": "查看运行日志、Agent 调用记录与性能指标",
  "icon": "mdi-stethoscope",
  "entries": {
    "manager": {
      "execution": "in_process",
      "module": "./manager.mjs"
    },
    "web": {
      "execution": "in_process",
      "module": "./web/client.mjs"
    }
  },
  "provides": [
    "manager.diagnostics@1"
  ],
  "requires": [
    "host.manager.operations@1",
    "host.manager.gateway-status@1",
    "manager.core@1"
  ],
  "optional": [
    "host.manager.call-history@1",
    "manager.gateway-runtime@1",
    "manager.performance@1",
    "manager.message-processing-control@1"
  ],
  "permissions": []
}
