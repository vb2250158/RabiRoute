{
  "schemaVersion": 2,
  "id": "io.rabiroute.agent.workbuddy",
  "version": "0.1.2",
  "displayName": "WorkBuddy（腾讯 AI 办公工作台）",
  "description": "将消息交给绑定的 WorkBuddy 任务，保留原会话和工作目录。",
  "icon": "mdi-robot-outline",
  "entries": {
    "manager": {
      "execution": "in_process",
      "module": "./manager.mjs"
    },
    "gateway": {
      "execution": "in_process",
      "module": "./gateway.mjs"
    },
    "web": {
      "execution": "in_process",
      "module": "./web/client.mjs"
    }
  },
  "provides": [
    "agent.adapter.workbuddy@1"
  ],
  "requires": [
    "host.agent-adapters@1"
  ],
  "optional": [],
  "permissions": []
}
