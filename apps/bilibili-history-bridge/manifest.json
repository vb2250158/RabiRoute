{
  "manifest_version": 3,
  "name": "RabiRoute Bilibili History Bridge",
  "version": "0.1.0",
  "description": "One-time installed, read-only bridge between Bilibili history and the local RabiRoute Manager.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://api.bilibili.com/x/web-interface/history/cursor*",
    "http://127.0.0.1:8790/api/bilibili-history/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "RabiRoute Bilibili History Bridge"
  }
}
