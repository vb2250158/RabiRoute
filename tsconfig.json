{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": { "@rabiroute/host-api/*": ["src/*.ts"] },
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/plugins/*/web/**", "src/plugins/rabi-antigravity-context/**", "src/plugins/rabi-codex-context/**", "src/plugins/rabi-dsh-context/**", "src/plugins/rabi-workbuddy-context/**", "src/plugins/napcat-stickers/**", "src/plugins/napcat-rabiroute/**", "src/plugins/rabi-speech/**", "src/plugins/remote-agent-rabiroute/**", "src/plugins/xiaoai-rabiroute/**"]
}
