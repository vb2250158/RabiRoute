{
  "name": "@rabiroute/plugin-sdk",
  "version": "1.3.1",  "type": "module",
  "license": "MIT",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./publication": {
      "types": "./publication.d.ts",
      "import": "./publication.mjs",
      "default": "./publication.mjs"
    },
    "./builder": {
      "import": "./builder.mjs",
      "types": "./builder.d.ts",
      "default": "./builder.mjs"
    },
    "./web-builder": {
      "types": "./web-builder.d.mts",
      "import": "./web-builder.mjs",
      "default": "./web-builder.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "api-operation-contract.d.ts",
    "publication.mjs",
    "publication.d.ts",
    "README.md",
    "README_en.md",
    "builder.mjs",
    "builder.d.ts",
    "builder.test.mjs",
    "public-source.mjs",
    "web-builder.mjs",
    "web-builder.d.mts",
    "web-runtime.mjs",
    "web-runtime.d.mts"
  ],
  "bin": {
    "rabi-plugin-build": "./builder.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@rabiroute/host-api": "^1.0.0"
  },
  "scripts": {
    "test": "node --test builder.test.mjs"
  }
}
