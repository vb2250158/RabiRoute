      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": "WeCom 群消息\n群：{groupId}\n发送者：{sender}（{userId}）\n消息：{messageId}\n\n{message}\n\n需要回复时，将 {sendRequestJson} POST 到 {sendApiUrl}；保留 channel=wecom 和 chatId。"
      }
    },
