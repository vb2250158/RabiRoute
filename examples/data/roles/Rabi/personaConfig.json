    },
    {
      "id": "rabi-heartbeat",
      "name": "Rabi 看板娘成长自检",
      "enabled": true,
      "trigger": {
        "type": "schedule",
        "schedule": {
          "id": "rabi-growth-check-interval",
          "name": "每 15 分钟",
          "enabled": true,
          "type": "interval",
          "intervalSeconds": 900
        }
      },
      "action": {
        "type": "deliver_agent",
        "message": "执行全计划效率巡检。",
        "template": "执行全计划巡检。先读 skills/one-plan-one-task-tracking.md。读取未终态计划和绑定任务状态，恢复可推进但空闲的任务。先由领域 Skill 判定当前动作是否真的需要审批；approvalRequest 完整且 responseStatus=pending 时由 Manager 派生阻塞。领域 Skill 确认命中默认授权时，必须同轮清除旧审批阻塞、更新回执并续投原任务。目标产物身份、owner 回执或外部产物不自动变成审批；其他等待继续询问、重试、改道或补证据。结束前确认没有可推进但空闲的计划。"
      }
    },
    {
      "id": "rabi-manual-agent-recreate",
      "name": "重新创建 Agent",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "manual_trigger"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": "重新创建Agent|重新创建 Agent|重建Agent|重建 Agent|会话归档转接|archive-handoff|recreate-agent"
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
      "id": "wecom-group-message",
