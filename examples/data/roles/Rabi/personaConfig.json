{
  "contextInjection": {
    "mode": "focused",
    "relevantKnowledgeLimit": 3,
    "personaMaxChars": 1600
  },
  "recentMessageLimits": {
    "napcat": 10,
    "remoteAgent": 10,
    "heartbeat": 0,
    "rolePanel": 10,
    "speech": 10,
    "fennenote": 10,
    "xiaoai": 10,
    "rabilink": 10,
    "wearable": 10,
    "webhook": 10,
    "wecom": 10,
    "weixin": 12,
    "feishu": 12
  },
  "speechTriggerKeywords": [],
  "automationRules": [
    {
      "id": "rabi-group-keywords",
      "name": "Rabi 看板娘呼唤",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "group_message"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": "Rabi|RabiRoute|看板娘|兔娘|陪陪|聊聊|在吗|记一下|提醒|怎么配|路由|人格|Agent|连接|状态"
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
      "id": "rabi-direct-reply",
      "name": "Rabi 直接回复陪伴",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "direct_reply"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": ""
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
      "id": "rabi-indirect-reply",
      "name": "Rabi 回复链陪伴",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "indirect_reply"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": ""
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
      "id": "rabi-private",
      "name": "Rabi 私聊陪伴",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "private"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": ""
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
      "id": "rabi-heartbeat",
      "name": "Rabi 看板娘成长自检",
      "enabled": true,
      "trigger": {
        "type": "schedule",
        "schedule": {
          "id": "rabi-growth-check-interval",
          "name": "每 15 分钟",
          "enabled": true,
          "type": "interval",
          "intervalSeconds": 900
        }
      },
      "action": {
        "type": "deliver_agent",
        "message": "执行全计划效率巡检。",
        "template": "执行全计划巡检。先读 skills/one-plan-one-task-tracking.md。读取未终态计划和绑定任务状态，恢复可推进但空闲的任务。先由领域 Skill 判定当前动作是否真的需要审批；approvalRequest 完整且 responseStatus=pending 时由 Manager 派生阻塞。领域 Skill 确认命中默认授权时，必须同轮清除旧审批阻塞、更新回执并续投原任务。目标产物身份、owner 回执或外部产物不自动变成审批；其他等待继续询问、重试、改道或补证据。结束前确认没有可推进但空闲的计划。"
      }
    },
    {
      "id": "rabi-manual-agent-recreate",
      "name": "重新创建 Agent",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "manual_trigger"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": "重新创建Agent|重新创建 Agent|重建Agent|重建 Agent|会话归档转接|archive-handoff|recreate-agent"
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
      "id": "wecom-group-message",
      "name": "WeCom group message",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "wecom_message"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": ""
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": "WeCom 群消息\n群：{groupId}\n发送者：{sender}（{userId}）\n消息：{messageId}\n\n{message}\n\n需要回复时，将 {sendRequestJson} POST 到 {sendApiUrl}；保留 channel=wecom 和 chatId。"
      }
    },
    {
      "id": "role-panel-message",
      "name": "角色面板消息",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "role_panel_message"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": ""
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    }
  ]
}
