  "automationRules": [
    {
      "id": "rabi-group-keywords",
      "name": "Rabi 看板娘呼唤",
      "enabled": true,
      "trigger": {
        "type": "message",
        "routeKinds": [
          "group_message"
        ],
        "targetGroupId": "",
        "allowedSpeakerNames": [],
        "regex": "Rabi|RabiRoute|看板娘|兔娘|陪陪|聊聊|在吗|记一下|提醒|怎么配|路由|人格|Agent|连接|状态"
      },
      "action": {
        "type": "deliver_agent",
        "message": "",
        "template": ""
      }
    },
    {
