{
  "enabled": true,
  "messageAdapters": [
    "napcat",
    "heartbeat"
  ],
  "messageAdapterPolicies": {
    "napcat": {
      "inputEnabled": true,
      "outputEnabled": true,
      "supportedOutputs": [
        "text",
        "image",
        "voice",
        "file"
      ],
      "allowedFileRoots": [
        "C:/Path/To/Your/Project/ReleasePkg"
      ],
      "messageGrouping": {
        "settleSeconds": 6,
        "incompleteSettleSeconds": 12,
        "maxWaitSeconds": 20
      }
    },
    "heartbeat": {
      "inputEnabled": true,
      "outputEnabled": true,
      "supportedOutputs": [
        "text",
        "image",
        "voice",
        "file"
      ]
    }
  },
  "gatewayPort": 8789,
  "napcatHttpUrl": "http://127.0.0.1:3000",
  "napcatAccessToken": "",
  "heartbeatIntervalSeconds": 900,
  "heartbeatMessage": "定时心跳巡检：请按当前计划、记忆和可用状态执行必要检查。",
  "codexThreadName": "QQ 消息监听",
  "codexCwd": ".",
  "agentModel": "",
  "agentRoleFile": "persona.md",
  "agentAdapters": [
    "codex"
  ],
  "primaryAgentAdapter": "codex",
  "messageProcessingAgents": {
    "codex": {
      "enabled": false,
      "model": "gpt-5.6-luna",
      "reasoningEffort": "medium"
    }
  },
  "dataDir": "./data/route/main",
  "configName": "main",
  "name": "Rabi Demo",
  "agentRoleId": "Rabi",
  "rolesDir": "./data/roles"
}
