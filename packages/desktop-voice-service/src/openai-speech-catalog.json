  "asr": {
    "origins": [
      "https://api.openai.com"
    ],
    "docs": "https://developers.openai.com/api/docs/guides/speech-to-text",
    "verifiedAt": "2026-11-15",
    "models": [
      {
        "id": "gpt-4o-transcribe",
        "label": "gpt-4o-transcribe",
        "supported": true
      },
      {
        "id": "gpt-4o-mini-transcribe",
        "label": "gpt-4o-mini-transcribe",
        "supported": true
      },
      {
        "id": "whisper-1",
        "label": "whisper-1",
        "supported": true
      },
      {
        "id": "gpt-4o-transcribe-diarize",
        "label": "gpt-4o-transcribe-diarize",
        "supported": true
      }
    ],
    "modes": [
      {
        "id": "utterance",
        "label": "整句录音后识别",
        "supported": true
      }
    ],
    "capabilities": [
      "整句转写",
      "多语言识别",
      "自动对话上下文"
    ],
    "parameters": [
      {
        "key": "asrLanguage",
        "label": "识别语言",
        "type": "text",
        "group": "文字与上下文",
        "default": "",
        "maxLength": 32,
        "parameter": "language",
        "note": "留空自动识别；可填写 zh、en、ja 等语言代码。",
        "owner": "user",
        "kind": "asr"
      },
      {
        "key": "asrPrompt",
        "label": "对话辅助识别提示",
        "type": "textarea",
        "group": "文字与上下文",
        "default": "",
        "maxLength": 4096,
        "parameter": "prompt",
        "models": [
          "gpt-4o-transcribe",
          "gpt-4o-mini-transcribe",
          "whisper-1"
        ],
        "note": "程序自动附带最近助手回复和专有词；说话人分离模型不支持此输入。",
        "owner": "system",
        "kind": "asr",
        "integration": "dialog-context"
      },
      {
        "key": "asrTemperature",
        "label": "采样温度",
        "type": "number",
        "group": "高级识别设置",
        "default": 0,
        "min": 0,
        "max": 1,
        "parameter": "temperature",
        "owner": "user",
        "kind": "asr"
      },
      {
        "key": "asrWordTimestamps",
        "label": "返回词级时间戳",
        "type": "boolean",
        "group": "返回信息",
        "default": true,
        "parameter": "timestamp_granularities[]",
        "models": [
          "whisper-1"
        ],
        "note": "请求 verbose_json；当前对话仍只使用识别文字。",
        "owner": "user",
        "kind": "asr",
        "feature": true
      },
      {
        "key": "asrSegmentTimestamps",
        "label": "返回分段时间戳",
        "type": "boolean",
        "group": "返回信息",
        "default": true,
        "parameter": "timestamp_granularities[]",
        "models": [
          "whisper-1"
        ],
        "owner": "user",
        "kind": "asr",
        "feature": true
      },
      {
        "key": "asrLogprobs",
        "label": "返回文字置信度",
        "type": "boolean",
        "group": "返回信息",
        "default": true,
        "parameter": "include[]",
        "models": [
          "gpt-4o-transcribe",
          "gpt-4o-mini-transcribe"
        ],
        "note": "返回识别置信度元数据；当前对话仍只使用识别文字。",
        "owner": "user",
        "kind": "asr",
        "feature": true
      },
      {
        "key": "asrUseContext",
        "label": "对话辅助识别",
        "type": "boolean",
        "group": "识别能力",
        "default": true,
        "feature": true,
        "owner": "user",
        "kind": "asr",
        "models": [
          "gpt-4o-transcribe",
          "gpt-4o-mini-transcribe",
          "whisper-1"
        ],
        "note": "转写时自动附带最近助手回复和专有词，帮助识别当前对话。"
      },
      {
        "key": "asrHotwords",
        "label": "专有词与拼写（每行一个）",
        "type": "textarea",
        "group": "识别偏好",
        "default": "",
        "maxLength": 2048,
        "owner": "user",
        "kind": "asr",
        "models": [
          "gpt-4o-transcribe",
          "gpt-4o-mini-transcribe",
          "whisper-1"
        ],
        "note": "你希望优先识别的人名、产品名或专业词语。"
      }
    ]
  }
