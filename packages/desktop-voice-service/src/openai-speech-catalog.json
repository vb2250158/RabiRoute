    "capabilities": [
      "文本按句输入",
      "24 kHz PCM 流式输出",
      "随时停止播报"
    ],
    "parameters": [
      {
        "key": "ttsSpeed",
        "label": "默认语速",
        "group": "播放偏好",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 4,
        "parameter": "speed",
